{
  "backendUrl": "https://graceful-fashion-backend.vercel.app",
  "paymentProvider": "paystack",
  "currency": "NGN",
  "currencyLocale": "en-NG",
  "checkoutEnabled": true,
  "testMode": true,
  "storeName": "Graceful Fashion",
  "checkoutButtonText": "Pay with Paystack",
  "checkoutEmailLabel": "Email address",
  "checkoutEmailPlaceholder": "you@example.com",
  "checkoutNote": "You will be redirected to Paystack to complete your payment.",
  "colors": {
    "background": "#fff8f4",
    "foreground": "#4b303b",
    "primary": "#b54863",
    "primaryForeground": "#ffffff",
    "secondary": "#f4dfe6",
    "secondaryForeground": "#5f3443",
    "border": "#e5cfd5",
    "muted": "#f3e8e3",
    "mutedForeground": "#806670",
    "accent": "#d4ad55",
    "accentForeground": "#4b303b",
    "backgroundOpacity": 1,
    "foregroundOpacity": 1,
    "primaryOpacity": 1,
    "primaryForegroundOpacity": 1,
    "secondaryOpacity": 1,
    "secondaryForegroundOpacity": 1,
    "borderOpacity": 1,
    "mutedOpacity": 1,
    "mutedForegroundOpacity": 1,
    "accentOpacity": 1,
    "accentForegroundOpacity": 1,
    "buttons": {
      "default": {
        "background": "#4b303b",
        "foreground": "#fff8f4",
        "border": "#4b303b",
        "opacity": 1
      },
      "hover": {
        "background": "#b54863",
        "foreground": "#ffffff",
        "border": "#b54863",
        "opacity": 1
      },
      "pressed": {
        "background": "#b54863",
        "foreground": "#ffffff",
        "border": "#b54863",
        "opacity": 1
      },
      "disabled": {
        "background": "#4b303b",
        "foreground": "#fff8f4",
        "border": "#4b303b",
        "opacity": 0.45
      }
    }
  }
}
